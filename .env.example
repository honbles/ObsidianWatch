# Copy to .env and fill in real values. Never commit the real .env file.
# M-09: these must NOT be left as placeholder values — the backend and
# management services refuse to start if they detect "changeme" or similar.

# Postgres/TimescaleDB password (shared by backend + management services)
DB_PASSWORD=

# Shared key agents use to authenticate to the backend
AGENT_API_KEY=

# JWT signing secret for management logins (openssl rand -hex 32, >= 32 chars)
JWT_SECRET=

# Encrypts connector credentials, API keys and SMTP password at rest (AES-256-GCM).
# REQUIRED. Generate with: openssl rand -base64 32
# Losing this key makes stored credentials unrecoverable — back it up separately from the DB.
OW_SECRET_KEY=

# Optional: extra origins (comma-separated) allowed to open WebSockets, e.g. https://siem.example.com
OW_ALLOWED_ORIGINS=
