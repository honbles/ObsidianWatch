# ObsidianWatch Environment Variables
# Copy to .env and edit before running docker compose up

# Database password — must match in both server.yaml files
DB_PASSWORD=changeme

# Optional: backend domain name (added to TLS cert SAN)
# Leave blank to use IP addresses only
BACKEND_DOMAIN=

# Optional: agent API key override
# If blank, use the key from backend/docker/server.yaml
AGENT_API_KEY=
HOST_IP=192.168.1.105
